PORT=4000
DATABASE_PATH=./data/tdm.sqlite
CORS_ORIGIN=http://localhost:5173

# Production: use your own RPC provider(s). Public endpoints may rate-limit.
RPC_ETHEREUM=https://eth.llamarpc.com
RPC_SEPOLIA=https://rpc.sepolia.org
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_BASE=https://mainnet.base.org

GITHUB_TOKEN=

MAX_ZIP_MB=20

# Admin authentication. Production startup rejects the default password or missing/weak JWT secret.
ADMIN_JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-at-least-32-random-characters

# Razorpay test-mode credentials only. Never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TEAM_PLAN_ID=

